@model List<Mune.Models.UserPost>

@{
    ViewData["Title"] = "Home Page";

    // Headline texts...
    var headlines = new List<string>
    {
        "Find musikken!",
        "Mød musikere!",
        "Spil sammen!",
        "Find musikfællesskab!",
        "Find band!",
        "Skab musikalske forbindelser!"
    };


    // ... chosen at random on startup
    var random = new Random();
    string selectedHeadline = headlines[random.Next(headlines.Count)];
}

<div class="text-center">
    <h1 class="display-4">@selectedHeadline</h1>

    <div class="row justify-content-center">
        <div class="col-12 col-md-6 post-scroll">
        @foreach (var userPost in Model)
        {
            <div class="card mb-3 shadow-sm card-style">
                <div class="card-body d-flex flex-column" style="text-align:left;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>   
                            <h5 class="card-title">
                                @userPost.Headline
                            </h5>             
                            <h6 class="card-subtitle mb-2 text-muted">
                                @userPost.City
                            </h6>
                        </div>
                        <div class="text-end">
                            <span style="color:darkmagenta; font-size: small;">
                                @userPost.User.UserName
                            </span>
                            <br/>
                            <span style="color: #b0b0b0; font-style: italic; font-size: small;">
                                @userPost.Timestamp.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-end mt-auto">
                        <div>
                            <p class="card-text">
                                @userPost.PostText
                            </p>
                        </div>
                        <div>
                           <a asp-controller="Home" asp-action="PostDetails" asp-route-id="@userPost.Id" class="btn btn-custom-muted btn-sm">Opslag</a>
                        </div>
                    </div>
                </div>
            </div>
        }
        </div>
    </div>
</div>

