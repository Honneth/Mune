@model Mune.Models.UserPost

@{
    ViewData["Title"] = "Opslagsdetaljer";
}

<div class="row justify-content-center">
    
    <br />
    <div class="card-body d-flex flex-column" style="text-align:left; max-width:800px">
        <h1>@Html.DisplayFor(model => model.Headline)</h1>
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h6 class="card-subtitle mb-2" style="color:darkmagenta;">   
                    @Html.DisplayFor(model => model.User.UserName)
                </h6>
                <h6 class="card-subtitle mb-2 text-muted">
                    @Html.DisplayFor(model => model.City)
                </h6>
            </div>
            <div class="text-end">

            </div>
        </div>
        <div class="d-flex justify-content-between align-items-end mt-auto">
            <div>
                <p class="card-text">
                    @Html.DisplayFor(model => model.PostText)
                </p>
                <span style="color: #b0b0b0; font-style: italic; font-size: small;">
                    Oprettet @Html.DisplayFor(model => model.Timestamp)
                </span>
            </div>
    @*      <div>
                <a asp-controller="Home" asp-action="PostDetails" asp-route-id="@userPost.Id" class="btn btn-custom-muted btn-sm">Opslag</a>
            </div> *@
        </div>
    </div>
</div>
